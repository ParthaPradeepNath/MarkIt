# Neon PostgreSQL connection string used by Prisma 7's pg driver adapter.
# Use Neon's pooled connection string; `pg` handles the pool in the app.
# `verify-full` keeps TLS verification strict and avoids pg's deprecated
# `sslmode=require` warning on newer pg releases.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full&channel_binding=require"

PORT=5000
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=*
