# Neon PostgreSQL connection string used by Prisma.
# Use the pooled connection string for the app (Prisma >= 5.10 handles pooling).
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

PORT=5000
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=*
